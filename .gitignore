# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore

*~
*.sw[mnpcod]
.tmp
*.tmp
*.tmp.*
UserInterfaceState.xcuserstate
$RECYCLE.BIN/

*.log
log.txt

/.sourcemaps
/.versions
/coverage

# ==========================================
# Ionic / Angular Frontend
# ==========================================
# Explicitly ignores node_modules anywhere in the project tree
node_modules/
**/node_modules/

npm-debug.log
yarn-error.log
/.ionic
/www
/platforms
/plugins

# Compiled output
/dist
/tmp
/out-tsc
/bazel-out

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-project
*.sublime-workspace

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*

# Miscellaneous Frontend
/.angular
/.angular/cache
.sass-cache/
/.nx
/.nx/cache
/connect.lock
/coverage
/libpeerconnection.log
testem.log
/typings

# System files
.DS_Store
Thumbs.db

# ==========================================
# Python / FastAPI Backend
# ==========================================
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.python-version

# Virtual Environments
.venv/
venv/
env/
ENV/
build/
*.egg-info/

# Environment Configurations & Secrets
.env
*.env
secrets.json

# ==========================================
# Local App Data & Proctoring Media Storage
# ==========================================

# Generated JSON files
backend/data/*.json
!backend/data/.gitkeep

# Test output
backend/dipstick_test_output.json

# Media files
*.webm
*.wav
*.mp3
temp_*

# Uploads & recordings
backend/uploads/
backend/static/uploads/
backend/recordings/

# Additional generated files and local caches
**/.angular/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/htmlcov/

# Local development and backup archives
/backend.zip
*.bak
*.old

# Local upload and evidence data
/backend/uploads/**
/backend/static/uploads/**
/backend/recordings/**