# ---------- Recall.ai (meeting bot) ----------
# Leave RECALL_API_KEY empty to run in MOCK mode (no Zoom / no Recall needed).
RECALL_API_KEY=
# Region where your Recall account lives (pay-as-you-go accounts are usually us-west-2)
RECALL_REGION=us-west-2

# ---------- This server ----------
# Public https URL of this server. Recall posts webhooks here.
# Dev: run `ngrok http 8000` and paste the https URL. Prod: your domain.
PUBLIC_BASE_URL=
# Shared secret added to the webhook URL (?token=...). Change it.
WEBHOOK_TOKEN=change-me
# Optional: protects /api/* and /ws/admin (send as ?key=... or X-Admin-Key header)
ADMIN_KEY=
# true/false. Empty = auto (mock when RECALL_API_KEY is empty)
MOCK_MODE=
DB_PATH=data/interviews.db

# ---------- Interview behaviour ----------
BOT_NAME=Interviewer
# Default per-question limit (seconds). Admin can override per interview / per question.
DEFAULT_TIME_LIMIT_SEC=300
# Reminder is sent this many seconds before time is up
WARN_BEFORE_SEC=60
# everyone = question goes to the meeting chat for all, dm = private message to the student
CHAT_MODE=everyone
# Bot leaves the call after the last question
AUTO_LEAVE=true

# ---------- Deepgram (key is added in the Recall dashboard, not here) ----------
DEEPGRAM_MODEL=nova-3
# "multi" = multilingual (Hindi+English code-switching). Use "en" or "hi" if you prefer.
DEEPGRAM_LANGUAGE=multi
DEEPGRAM_INTERIM=true
# Separate stream per participant (better speaker attribution when admin/observers talk).
# Turn on after the first successful test.
PERFECT_DIARIZATION=false

# ---------- Zoom authorization for bots (Zoom requires this for joining via SDK) ----------
# One of these may be needed, see README section "Zoom authorization".
ZOOM_OBF_TOKEN_URL=
ZOOM_ZAK_URL=